    },
    {
      "from": "sf_search",
      "to": "act",
      "mod": "fn"
    },
    {
      "from": "sf_search",
      "to": "act",
      "mod": "cmd+alt"
    },
    {
      "from": "sf_search",
      "to": "act",
      "mod": "cmd+shift"
    },
    {
      "from": "sf_search",
      "to": "paste",
      "mod": "cmd"
    },
    {
